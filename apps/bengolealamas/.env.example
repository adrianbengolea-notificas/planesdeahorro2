# URL pública canónica del sitio B&L (sin barra final).
NEXT_PUBLIC_APP_URL=https://bengolealamas.com.ar

# Token de Search Console (meta google-site-verification), si no verificás por DNS.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Identificador multisite (Firestore futuro)
NEXT_PUBLIC_SITE_ID=bl

# Chat de recepción (IA vía app raíz / adrianbengolea.com.ar). Ver docs/case-intake-bengolealamas.md
# INTAKE_BRIDGE_URL=https://adrianbengolea.com.ar/api/case-intake/continue
# INTAKE_BRIDGE_URL=http://localhost:9002/api/case-intake/continue
# INTAKE_BRIDGE_SECRET=

# Envío de notas a listas CSV (Resend). Dominio: bengolealamas.com.ar
# RESEND_API_KEY=
# RESEND_BL_FROM=estudio@bengolealamas.com.ar
# RESEND_BL_REPLY_TO=estudio@bengolealamas.com.ar
