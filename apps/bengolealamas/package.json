{
  "name": "bengolealamas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev -p 9003",
    "dev:turbo": "next dev --turbopack -p 9003",
    "dev:clean": "npm run clean && npm run dev",
    "prebuild": "npm install clsx@^2.1.1 tailwind-merge@^3.0.1 --prefix ../../packages/shared --no-package-lock --ignore-scripts --no-fund --no-audit",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-public.mjs",
    "start": "next start -p 9003",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/content-types": "file:../../packages/content-types",
    "@repo/shared": "file:../../packages/shared",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
